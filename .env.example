SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Server-only values for AI note extraction and Cliniko demo seeding.
# Do not expose these with a VITE_ prefix.
OPENAI_API_KEY=sk-your_openai_key
OPENAI_MODEL=gpt-4.1-mini
# Optional: use a different OpenAI key/model for Cliniko seeding only.
# CLINIKO_SEED_OPENAI_API_KEY=sk-your_seed_key
# CLINIKO_SEED_OPENAI_MODEL=gpt-4.1-mini
CLINIKO_API_KEY=your_cliniko_api_key
CLINIKO_USER_AGENT="AHTR Demo (you@example.com)"

# Optional: pin a specific Cliniko resource when the account has multiples.
# CLINIKO_BUSINESS_ID=123
# CLINIKO_PRACTITIONER_ID=123
# CLINIKO_APPOINTMENT_TYPE_ID=123

# Server-only values can live in .env.local later, but must not be exposed with a VITE_ prefix.
# SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
# SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
# SUPABASE_ACCESS_TOKEN=sbp_your_supabase_management_api_token
